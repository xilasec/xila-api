# Dev works out of the box: `pnpm dev` proxies /api to the Go server (see
# vite.config.js). You usually do NOT need this file.
#
# Override the dev proxy target (e.g. API on another host/port):
# VITE_API_PROXY=http://localhost:8080
#
# Or bypass the proxy and call an absolute API URL directly (needs CORS):
# VITE_API_URL=http://localhost:8080/api/v1
