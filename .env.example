# Xila reads this file itself when it sits in the working directory (or point
# ENV_FILE at it). Variables already set in the environment take precedence.
# Any secret below can instead come from a file: NAME_FILE=/path/to/file.
# A secret's value (NAME or NAME_FILE content) can also be a reference,
# resolved at startup: aws-sm://<name-or-ARN>[#json-key], gcp-sm://projects/
# <p>/secrets/<s>[/versions/<v>][#json-key], vault://<path>[#key], or
# azure-kv://<vault>/<secret>[/<version>]. See README.md "Configuration" for
# each backend's auth env vars. SECRETS_TIMEOUT bounds one lookup (default
# 30s); SECRETS_REFRESH_INTERVAL re-reads a reference/NAME_FILE secret live
# (default 5m, 0 disables it) — DB_PASSWORD and METRICS_TOKEN pick up a
# rotated value without a restart, most others still need one.
# SECRETS_TIMEOUT=30s
# SECRETS_REFRESH_INTERVAL=5m
# Application
# APP_ENV switches safe defaults + startup validation: `development` (permissive
# CORS, throwaway JWT secret, insecure cookies OK) or `production` (fail-fast on a
# missing/weak JWT secret, same-origin CORS, Secure cookies). `test` is for CI.
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# Security hardening. Defaults follow APP_ENV; override as needed.
#   CORS_ALLOWED_ORIGINS  comma-separated allow-list. Dev defaults to '*'; prod
#                         defaults to same-origin only (empty). Set to your UI
#                         origin(s) if the SPA is served from another host.
#   TRUSTED_PROXIES       comma-separated proxy IPs/CIDRs to trust for
#                         X-Forwarded-* (correct client IP behind a load balancer).
#   COOKIE_SECURE         Secure flag on auth cookies (defaults to true in prod).
# CORS_ALLOWED_ORIGINS=https://xila.example.com
# TRUSTED_PROXIES=10.0.0.0/8
# COOKIE_SECURE=true

# Password sign-in / registration / reset throttling (PostgreSQL-backed, shared
# by all replicas; 0 disables a limit). /auth/config and SSO are never limited.
# AUTH_RATE_LIMIT_IP_PER_MIN=60
# AUTH_RATE_LIMIT_ACCOUNT=10
# AUTH_RATE_LIMIT_ACCOUNT_WINDOW=15m

# Service accounts: the longest API-key lifetime (keys default to 30 days), and
# the lifetime of a session from the workload-identity token exchange (≤ 1h).
# SERVICE_ACCOUNT_KEY_MAX_DAYS=90
# FEDERATION_TOKEN_TTL=15m

# Where server-side requests to configured URLs (issue trackers, connectors,
# SSO, webhooks, mirrors) may go. Cloud-metadata / link-local addresses are
# always refused. Private networks are allowed by default (self-hosted Jira,
# GitLab…); loopback only in development. Listed hosts bypass both rules.
# OUTBOUND_ALLOW_PRIVATE=true
# OUTBOUND_ALLOW_LOOPBACK=false
# OUTBOUND_ALLOWED_HOSTS=jira.internal

# Durable notification delivery (outbox, sent by the leader instance).
# NOTIFY_MAX_ATTEMPTS=8
# NOTIFY_RETRY_BASE=30s
# NOTIFY_RETRY_MAX=1h
# NOTIFY_RETENTION=168h
# NOTIFY_DISPATCH_INTERVAL=2s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=xila
DB_PASSWORD=xila
DB_NAME=xila
DB_SSLMODE=disable

# Connection pool + timeouts (optional; sensible defaults shown). Durations are
# Go-style (e.g. 90s, 30m, 1h). DB_CONNECT_TIMEOUT is added to the DSN.
# DB_MAX_CONNS=20
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
# DB_HEALTH_CHECK_PERIOD=1m
# DB_CONNECT_TIMEOUT=10s
# Caps any single query so a runaway one can't pin a connection (0 disables).
# DB_STATEMENT_TIMEOUT=30s
# Reporting reads on a replica and/or their own capped pool:
# DB_READ_URL=postgres://reader:...@replica:5432/xila?sslmode=require
# DB_READ_STATEMENT_TIMEOUT=60s

# HTTP server limits (optional).
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_BODY_LIMIT_MB=32

# Auth (REQUIRED outside development)
JWT_SECRET=change-me-in-production
# Rotate JWT_SECRET without ending every session: set the new value above,
# move the old one here (comma-separated if more than one), wait out the
# longest JWT_TTL so every session signed with it has expired, then remove
# it. Verify-only — never signs a new token.
JWT_PREVIOUS_SECRETS=

# Email + password sign-in. false = SSO only: registration closes once a user
# exists and only the instance owner may still log in with a password
# (break-glass, logged). API tokens are unaffected.
PASSWORD_LOGIN_ENABLED=true
# MCP server for AI agents at POST /api/v1/mcp (tools run with the caller's token).
MCP_ENABLED=true
# Opt-in AI-assisted triage (bring your own model). The model proposes a
# false-positive verdict, exploitability assessment or fix; nothing applies
# until a person accepts it. Projects can opt out. AI_PROVIDER is
# openai-compatible (any chat-completions server) or anthropic.
AI_TRIAGE_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_RATE_LIMIT=30
AI_TIMEOUT=90s
# Create an account on someone's first SSO login (false = admins pre-provision
# accounts with POST /users; unknown people get an error). The default: each
# provider added on the SSO page may override it.
SSO_AUTO_CREATE_USERS=true

# SSO providers are normally added, tested and switched on/off by an instance
# admin on the SSO page (any number, OIDC and SAML; needs PUBLIC_URL and
# INTEGRATION_SECRET_KEY below). The OIDC_* / SAML_* settings define one more
# provider of each kind, shown read-only there, at the original URLs below.

# Single Sign-On via OpenID Connect (optional; off by default). When enabled the
# login page shows a "Continue with <provider>" button. The redirect URL must be
# registered with the provider and point at /api/v1/auth/oidc/callback.
OIDC_ENABLED=false
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
OIDC_PROVIDER_NAME=Google
# Space/comma separated; add "groups" only if your IdP needs it to emit groups.
OIDC_SCOPES=openid email profile
# ID-token claim holding the user's groups (dotted path for nested claims,
# e.g. realm_access.roles for Keycloak realm roles).
OIDC_GROUPS_CLAIM=groups
# Treat an ID token WITHOUT email_verified as verified, so it may link to an
# existing account by email (Entra ID omits the claim). Explicit false never links.
OIDC_TRUST_UNVERIFIED_EMAIL=false

# Single Sign-On via SAML 2.0 (optional; off by default). Requires PUBLIC_URL.
# Give the IdP: entity id <PUBLIC_URL>/api/v1/auth/saml/metadata, ACS URL
# <PUBLIC_URL>/api/v1/auth/saml/acs (or import the metadata URL).
SAML_ENABLED=false
# The IdP metadata: a URL fetched at boot and refreshed hourly, or the XML itself
# (wins when both set).
SAML_IDP_METADATA_URL=
SAML_IDP_METADATA=
# SP entity id (default <PUBLIC_URL>/api/v1/auth/saml/metadata).
SAML_ENTITY_ID=
# PEM RSA cert + key (\n escapes allowed). Empty = generated once and stored in
# the database, sealed with INTEGRATION_SECRET_KEY (then required).
SAML_SP_CERT=
SAML_SP_KEY=
SAML_PROVIDER_NAME=SAML SSO
# Attribute carrying the email (empty = email, mail, the WS-Fed emailaddress
# claim, the LDAP mail OID, then an emailAddress NameID).
SAML_EMAIL_ATTRIBUTE=
# Comma list of attributes carrying groups, e.g.
# http://schemas.microsoft.com/ws/2008/06/identity/claims/groups (Entra) or memberOf.
SAML_GROUPS_ATTRIBUTE=groups
# Trust the IdP's email to link a first login to an existing account.
SAML_LINK_BY_EMAIL=true
# Accept unsolicited (IdP-initiated) responses — allows login CSRF.
SAML_ALLOW_IDP_INITIATED=false
SAML_SIGN_REQUESTS=true

# SMTP for "email" notification channels (optional). SMTP_TLS: starttls | tls | none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
JWT_TTL=24h
# How recently a session must have signed in to create an API token (0 = no check).
REAUTH_WINDOW=10m

# OpenTelemetry: off until you have a collector (the dev compose stack runs one).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=xila-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Prometheus /metrics (same instruments as OTLP), here on a separate listener
# that you keep internal. To serve it on the main port instead, clear
# METRICS_ADDR; production then needs METRICS_TOKEN.
METRICS_ENABLED=true
METRICS_ADDR=:9090
METRICS_TOKEN=

# Component policies (license / security / operational rules, managed under
# /policies) are re-evaluated on every SBOM upload, after policy edits, and on
# this interval — catching KEV/EPSS, outdated and license-data changes. 0 = off.
# (Replaces LICENSE_DENYLIST, which is ignored now.)
POLICY_EVAL_INTERVAL=6h

# Exploit-intel enrichment (EPSS + CISA KEV) → priority score
ENRICH_ENABLED=true
ENRICH_INTERVAL=6h
# KEV catalogs (each enrichment run): cisa, enisa (ENISA EUVD exploited list),
# vulncheck (needs VULNCHECK_API_TOKEN; added to the default when it is set).
# A catalog that fails keeps its last list.
KEV_SOURCES=cisa,enisa
VULNCHECK_API_TOKEN=
# Mirror URLs; empty = upstream.
KEV_CISA_URL=
KEV_ENISA_URL=
KEV_VULNCHECK_URL=
# NVD CVSS vectors/scores for findings' CVEs (on ENRICH_INTERVAL). Off by
# default: without an API key NVD allows 5 requests / 30 s.
NVD_ENABLED=false
NVD_API_KEY=
# Public exploits per CVE (ExploitDB, Metasploit, Nuclei templates) → finding
# exploit_maturity (poc / weaponized) → priority. Synced by the leader.
EXPLOIT_INTEL_ENABLED=true
EXPLOIT_INTEL_INTERVAL=24h
EXPLOIT_INTEL_SOURCES=exploitdb,metasploit,nuclei
# Mirror URLs (air-gapped installs); empty = the upstream feed.
EXPLOIT_INTEL_EXPLOITDB_URL=
EXPLOIT_INTEL_METASPLOIT_URL=
EXPLOIT_INTEL_NUCLEI_URL=

# EU CRA Article 14: the manufacturer named in reports of actively exploited
# vulnerabilities (projects opt in on their Compliance tab), its main EU
# establishment (ISO code: its coordinator CSIRT receives the reports), and how
# often cases are opened and deadlines alerted (0 = off).
CRA_MANUFACTURER_NAME=
CRA_MANUFACTURER_ADDRESS=
CRA_MANUFACTURER_CONTACT=
CRA_MANUFACTURER_MEMBER_STATE=
CRA_SWEEP_INTERVAL=15m

# Keep stored SBOMs current: match their components against advisory sources,
# so new CVEs appear (and fixed ones close) without re-scanning.
# VULNMATCH_SOURCES: comma list of osv (OSV.dev), github (GitHub Advisory
# Database), osv-local (imported OSV mirror — air-gapped), private (internal
# advisories), nvd (CPE matching via NVD for components with a CPE but no
# purl; rate-limited, uses NVD_API_KEY). Results are merged; air-gapped
# installs use osv-local,private.
VULNMATCH_ENABLED=true
VULNMATCH_INTERVAL=12h
VULNMATCH_SOURCES=osv
VULNMATCH_OSV_URL=https://api.osv.dev
VULNMATCH_GITHUB_URL=https://api.github.com
VULNMATCH_GITHUB_TOKEN=
# Local OSV mirror: download these ecosystems' exports (<url>/<Ecosystem>/all.zip)
# at start and on the interval. Empty = import by upload only (/advisories page).
VULNMATCH_OSV_ECOSYSTEMS=
VULNMATCH_OSV_MIRROR_URL=https://osv-vulnerabilities.storage.googleapis.com
VULNMATCH_OSV_MIRROR_INTERVAL=24h
# vulnerablecode (VulnerableCode purl search; the public instance needs a key)
# and jvn (JVN iPedia CVE alias enrichment) sources.
VULNMATCH_VULNERABLECODE_URL=
VULNMATCH_VULNERABLECODE_API_KEY=
VULNMATCH_JVN_URL=https://jvndb.jvn.jp
VULNMATCH_JVN_FROM_YEAR=2015
VULNMATCH_JVN_INTERVAL=24h

# PSIRT: publish CSAF 2.0 advisories about your own products. PSIRT_PUBLIC=true
# serves them unauthenticated as a CSAF provider directory.
PSIRT_ADVISORY_PREFIX=XILA-SA
PSIRT_PUBLISHER_NAME=
PSIRT_PUBLISHER_NAMESPACE=
PSIRT_PUBLISHER_CONTACT=
PSIRT_PUBLIC=false

# Stored, versioned VEX documents (/vex-documents): tracking-ID prefix,
# <prefix>-<year>-<NNNN>.
VEX_DOCUMENT_PREFIX=XILA

# Outdated components: look up each SBOM package's latest release in its registry
# (npm, PyPI, Maven, Go, crates.io, NuGet, RubyGems, Packagist). Set
# PKGMETA_ENABLED=false for air-gapped installs; PKGMETA_<ECO>_URL points an
# ecosystem at an internal mirror (Artifactory / Nexus). Unset URL = public registry.
PKGMETA_ENABLED=true
PKGMETA_INTERVAL=1h
PKGMETA_TTL=24h
PKGMETA_CONCURRENCY=4
PKGMETA_REQUESTS_PER_SECOND=5
# PKGMETA_NPM_URL=https://artifactory.example.com/artifactory/api/npm/npm-remote
# PKGMETA_PYPI_URL=https://nexus.example.com/repository/pypi-proxy/pypi
# PKGMETA_MAVEN_URL=https://nexus.example.com/repository/maven-central
# PKGMETA_GO_URL=https://athens.example.com
# PKGMETA_CARGO_URL=https://crates.io/api/v1
# PKGMETA_NUGET_URL=https://nexus.example.com/repository/nuget-proxy/index.json
# PKGMETA_GEM_URL=https://rubygems.org
# PKGMETA_COMPOSER_URL=https://repo.packagist.org

# Reopen findings whose risk acceptance has expired, this often
EXCEPTION_SWEEP_INTERVAL=1h

# Alert on findings that breach (or are about to breach) their SLA, this often (0 = off)
SLA_SWEEP_INTERVAL=1h

# Delete non-default branches (and their findings) not scanned for this long
# (0 = keep forever; releases have their own RELEASE_RETENTION, off by default)
BRANCH_RETENTION=2160h

# Issue trackers (Jira / GitHub / GitLab) and pull connectors (Dependency-Track /
# DefectDojo). INTEGRATION_SECRET_KEY encrypts their API tokens at rest — and SSO
# provider client secrets / SAML SP keys, personal and signed-webhook secrets, and
# two-factor secrets: 32 random bytes, base64 (openssl rand -base64 32). Unset =
# none of them can be configured.
INTEGRATION_SECRET_KEY=
# Rotate INTEGRATION_SECRET_KEY without making stored secrets unreadable: set
# the new key above, move the old one here (comma-separated if more than one).
# A leader-elected background job re-seals every stored value under the new
# key; GET /admin/secrets/status shows each column's progress — remove the old
# key from here once every column reports 0 "previous".
INTEGRATION_SECRET_KEY_PREVIOUS=
# External UI origin, for links back to Xila in issue bodies (empty = no link).
# Required for SAML and for adding SSO providers on the SSO page (their redirect,
# ACS and metadata URLs are built from it).
PUBLIC_URL=
# Where users get this instance's source code, linked on every page. Xila is
# AGPL-3.0: if you run a modified version for others, point this at your source.
SOURCE_URL=https://github.com/xilasec/xila-api
# Two-way issue sync + auto-create, this often (0 = off)
ISSUE_SYNC_INTERVAL=15m
# Group open findings into remediation actions and refresh due dates / owners /
# auto-close this often (0 = off; ingest still does it per scan)
REMEDIATION_SWEEP_INTERVAL=15m
# Create remediation actions from proposals without waiting for a user to accept
REMEDIATION_AUTO_CREATE=false
# Pull every enabled Dependency-Track / DefectDojo connector this often (0 = off;
# "Pull now" still works)
CONNECTOR_PULL_INTERVAL=6h
# Daily metric snapshots for trend charts: today + yesterday are recomputed this
# often; the first run reconstructs the last 90 days (0 = off)
METRICS_SNAPSHOT_INTERVAL=1h
# Serve /portfolio from the snapshots above (large instances):
# PORTFOLIO_FROM_SNAPSHOTS=true
# Statement cap for the snapshot job's full passes (its own 2-connection pool)
# DB_JOB_STATEMENT_TIMEOUT=15m

# Four-eyes approval for auto-triage rules: created/edited rules stay pending (and
# never apply) until a different admin approves them.
TRIAGE_RULES_REQUIRE_APPROVAL=false
# How often triage rules with a daily schedule are checked (0 = off).
# TRIAGE_SCHEDULE_INTERVAL=1h
# Four-eyes approval for manual assessments: an analyst's status / severity change
# becomes a pending request until a different project owner (or instance admin)
# approves it. Assignee changes and comments are never gated.
ASSESSMENT_REQUIRES_APPROVAL=false
# Four-eyes for risk acceptances (default: true in production, false otherwise)
# RISK_ACCEPTANCE_REQUIRES_APPROVAL=true
# Announce approved risk acceptances this long before they expire (0 = never)
RISK_ACCEPTANCE_EXPIRY_WARNING=168h

# Scheduled summaries are set per notification channel (daily / weekly at an
# hour, UTC) on the Notifications page; there is no global digest setting.

# Async ingestion: queue uploads (202) and drain them with a worker pool via a
# durable Postgres job queue, so a burst of CI uploads is accepted in seconds.
# The `xila` CLI's --gate/--wait polls the scan to finish and retries the 429
# sent once the queue is full. false processes each upload inline instead.
INGEST_ASYNC=true
INGEST_WORKERS=4
INGEST_POLL_INTERVAL=2s
INGEST_MAX_ATTEMPTS=3
# Shed uploads with 429 once this many jobs are waiting (0 = accept unboundedly).
# INGEST_MAX_QUEUE_DEPTH=10000
# INGEST_QUEUE_SAMPLE_INTERVAL=5s

# Skip the pipeline for a report identical to the target's previous scan
# (compares parsed findings, not raw bytes, so an embedded timestamp doesn't
# matter). false always reprocesses; a per-upload force=true always does too.
# INGEST_SKIP_UNCHANGED=true

# Where a queued job's raw upload lives between accepting it and a worker
# processing it (M11 11.8): postgres (scan_jobs.payload, the default) or s3
# (any S3-compatible object storage; scan_jobs keeps only a reference). A
# million 1 MB reports is a terabyte of Postgres bytea traffic — s3 avoids
# that at very high volume.
# INGEST_PAYLOAD_STORE=postgres

# S3 (or S3-compatible: MinIO, Ceph, Cloudflare R2, GCS interop) settings,
# only used when INGEST_PAYLOAD_STORE=s3.
# S3_ENDPOINT=                  # unset = AWS's regional endpoint; set for anything else
# S3_REGION=us-east-1
# S3_BUCKET=xila-ingest-payloads
# S3_PREFIX=                    # optional key prefix under the bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=         # or S3_SECRET_ACCESS_KEY_FILE for a mounted secret
# S3_FORCE_PATH_STYLE=false     # true for most non-AWS S3-compatible services

# Retention (0 = keep forever). Never deletes a version's current SBOM, a
# finding's last scan, the latest scan of a target, or the default version.
# RELEASE_RETENTION=0
# SBOM_RETENTION_KEEP=0
# SBOM_RETENTION_AGE=0
# SCAN_RETENTION=0
# LOG_RETENTION=2160h
# Audit log entries are kept this long (0 = forever).
# AUDIT_RETENTION=8760h
# Archived projects/engagements/scans/findings stay restorable this long, then
# are purged (0 = forever).
# ARCHIVE_RETENTION=720h
# Archive findings fixed longer ago than this (off by default):
# FINDING_ARCHIVE_AFTER=4320h

# LDAP / Active Directory sign-in through the password form (optional).
# LDAP_ENABLED=true
# LDAP_URL=ldaps://dc.corp.example:636
# LDAP_BIND_DN=CN=xila-svc,OU=Service Accounts,DC=corp,DC=example
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=DC=corp,DC=example
# LDAP_USER_FILTER=(&(objectClass=person)(|(mail={login})(sAMAccountName={login})))
# LDAP_CA_CERT=-----BEGIN CERTIFICATE-----\n...
